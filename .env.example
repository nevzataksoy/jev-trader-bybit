# Isolated Bybit Demo Trading account used for balances, spot history and spot execution.
# Create the key after switching the mainnet account to Demo Trading.
# Private REST requests are sent to https://api-demo.bybit.com.
BYBIT_ACCOUNT_ENV=demo
BYBIT_API_KEY=your_demo_api_key
BYBIT_API_SECRET=your_demo_api_secret

# Trading is fail-safe disabled until explicitly enabled.
TRADING_ENABLED=false
MIN_CONFIDENCE_THRESHOLD=0.72
BUY_PCT_OF_USDT=0.20
SELL_PCT_OF_HOLDING=0.25
MIN_TRADE_USDT=5
MIN_USDT_RESERVE_PCT=0.20
MAX_ASSET_ALLOCATION_PCT=0.50
TARGET_DAILY_VOLATILITY_PCT=3
MAX_DAILY_VOLATILITY_PCT=10
MAX_SPREAD_PCT=0.25
MIN_BEAR_REBOUND_SCORE=0.62

# Required only if BYBIT_ACCOUNT_ENV=mainnet. Keep false for this project.
ALLOW_LIVE_TRADING=false

# Official TypeSafe / Jev SDK configuration.
TYPESAFE_API_KEY=your_typesafe_api_key
JEV_MODEL_NAME=jev-1.13.0

# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@127.0.0.1:5432/jev-trader-bybit?sslmode=disable
# Neon/Vercel PostgreSQL uses its provided pooled URL, normally with sslmode=require.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Vercel sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=generate_a_random_secret_of_at_least_32_characters

# Replace after the first Vercel deployment.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
