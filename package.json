{
  "name": "jev-trader-bybit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "strategy:registry": "node scripts/generate-strategy-registry.mjs",
    "predev": "npm run strategy:registry",
    "dev": "next dev",
    "prebuild": "npm run lint && npm run typecheck && npm run test",
    "build": "node scripts/setup-db-if-production.mjs && next build",
    "start": "next start",
    "prelint": "npm run strategy:registry",
    "lint": "eslint app lib scripts next.config.ts --no-cache",
    "pretypecheck": "npm run strategy:registry",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run strategy:registry",
    "test": "vitest run",
    "db:setup": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/setup-db.mjs",
    "strategy:report": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/strategy-report.mjs",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bybit-api": "^4.7.6",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
